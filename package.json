{
  "name": "dsh-android-runner",
  "version": "1.4.2",
  "license": "MIT",
  "description": "DeepSeek Harness tool for safe Android JVM/Robolectric and instrumentation test execution with structured Gradle diagnostics.",
  "keywords": ["deepseek-harness", "android", "testing", "robolectric", "gradle", "dsh"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pezhman5252/dsh-android-runner.git"
  },
  "bugs": {
    "url": "https://github.com/Pezhman5252/dsh-android-runner/issues"
  },
  "homepage": "https://github.com/Pezhman5252/dsh-android-runner#readme",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "build": "tsc",
    "verify": "node test/verify.mjs && node test/schema-verify.mjs && node test/runtime-compat.mjs",
    "prepublishOnly": "npm run build && npm run verify"
  },
  "engines": { "node": ">=22.19.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.2.0"
  },
  "peerDependenciesMeta": { "@deepseek-ai/cordis": { "optional": true } },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {}
}
